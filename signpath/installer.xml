<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer" (slug: installer) for the project ValTrainer.
  Paste it into SignPath: Project ValTrainer > Artifact configurations > installer > Edit.

  The artifact is the GitHub workflow artifact "unsigned-setup" uploaded by .github/workflows/release.yml: a zip with
  ValTrainer-<version>-Setup.exe, the Inno Setup installer built from the already signed ValTrainer.exe (see app.xml).
  SignPath can't open Inno Setup installers, so the installer itself is signed as a plain PE file; its product name
  must be "ValTrainer" and its product version the "version" parameter (x.y.z.0, from project.godot).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="ValTrainer-*-Setup.exe" product-name="ValTrainer" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
