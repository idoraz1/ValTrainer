# Normalize text files to LF in the repository (Godot's default).
* text=auto eol=lf

# Windows-only scripts keep CRLF in the working tree.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.iss text eol=crlf
*.sln text eol=crlf

# Binary assets: never diff or convert.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.bmp binary
*.tga binary
*.ico binary
*.hdr binary
*.exr binary
*.ogg binary
*.wav binary
*.mp3 binary
*.glb binary
*.bin binary
*.fbx binary
*.blend binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.res binary
*.scn binary
*.zip binary
*.tpz binary
*.exe binary
*.dll binary
*.pdb binary
